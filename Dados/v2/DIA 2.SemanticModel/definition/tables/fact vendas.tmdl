	partition 'fact vendas' = m
		mode: import
		source =
				let
				    Source = raw,
				    #"C:\Users\ecsilva\OneDrive - GDM Seeds\Capacitação Power Skills\raw\_fato_vendas_raw csv" = Source{[#"Folder Path"="C:\Users\ecsilva\OneDrive - GDM Seeds\Capacitação Power Skills\raw\",Name="fato_vendas_raw.csv"]}[Content],
				    #"Imported CSV" = Csv.Document(#"C:\Users\ecsilva\OneDrive - GDM Seeds\Capacitação Power Skills\raw\_fato_vendas_raw csv",[Delimiter=";", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(#"Imported CSV", [PromoteAllScalars=true]),
				    #"Normalized data_venda" = Table.TransformColumns(
				        #"Promoted Headers",
				        {{"data_venda", each
				            let
				                val = Text.Trim(_)
				            in
				                if val = null or val = "" then
				                    null
				                else if Text.Length(val) = 10 and Text.At(val, 4) = "-" then
				                    let
				                        dd = Number.FromText(Text.Middle(val, 8, 2)),
				                        mm = Number.FromText(Text.Middle(val, 5, 2)),
				                        aaaa = Number.FromText(Text.Start(val, 4))
				                    in
				                        try Text.PadStart(Text.From(dd), 2, "0") & "/" & Text.PadStart(Text.From(mm), 2, "0") & "/" & Text.From(aaaa) otherwise null
				                else
				                    val,
				            type text
				        }}
				    ),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Normalized data_venda",
				        {
				            {"id_venda", type text},
				            {"id_pedido", type text},
				            {"data_venda", type date},
				            {"id_cliente", type text},
				            {"id_produto", type text},
				            {"quantidade", Int64.Type},
				            {"preco_tabela_brl", type number},
				            {"desconto_pct", type number},
				            {"preco_unitario_brl", type number},
				            {"valor_bruto_brl", type number},
				            {"valor_desconto_brl", type number},
				            {"valor_liquido_brl", type number},
				            {"custo_total_brl", type number},
				            {"canal_venda", type text},
				            {"forma_pagamento", type text}
				        },
				        "pt-BR"
				    ),
				    #"Replaced blank forma_pagamento" = Table.TransformColumns(
				        #"Changed Types",
				        {{"forma_pagamento", each
				            if _ = null or Text.Trim(_) = "" then "Não Informado" else _,
				            type text
				        }}
				    )
				in
				    #"Replaced blank forma_pagamento"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

