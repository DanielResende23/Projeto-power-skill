table 'dim calendário'
	lineageTag: 249d5831-7796-4cd5-8d28-2e8c030f64b5
	dataCategory: Time

	/// Chave primária da tabela de datas — usada nos relacionamentos (oculta nos visuais)
	column Date
		isHidden
		isUnique
		formatString: dd/MM/yyyy
		lineageTag: 468f6412-bc65-4f48-8b12-f3678499f906
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	/// Data formatada para exibição nos visuais
	column Data
		formatString: dd/MM/yyyy
		lineageTag: e4595265-8374-4e5a-907f-dd4e0aae6b60
		summarizeBy: none
		isNameInferred
		sourceColumn: [Data]

