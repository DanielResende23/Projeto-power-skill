		summarizeBy: none
		isNameInferred
		sourceColumn: [Semana Ano]

	/// Número do dia da semana (1=Seg, 7=Dom) — auxiliar de ordenação
	column 'Dia Semana Num'
		isHidden
		formatString: 0
		lineageTag: 3edd0b28-af53-49e7-8913-f30091f9e560
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dia Semana Num]

	/// Nome completo do dia da semana em português
	column 'Dia Semana'
		lineageTag: 663bcacd-ff7b-40f3-8314-7f25e475e6e4
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dia Semana]
		sortByColumn: 'Dia Semana Num'

	/// Abreviação do dia da semana (seg, ter, ...)
	column 'Dia Semana Abrev'
		lineageTag: 31178205-df73-49d8-addb-f460ddbbb046
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dia Semana Abrev]
		sortByColumn: 'Dia Semana Num'

	/// Dia do mês (1-31)
	column 'Dia Mes'
		formatString: 0
		lineageTag: a53e4a13-6706-43ed-a88e-c7bc40a72f6c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dia Mes]

	/// Dia do ano (1-365/366)
	column 'Dia Ano'
		formatString: 0
		lineageTag: 215002f1-0105-4309-b687-3f2ca96105cd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dia Ano]

	/// Classifica o dia: Dia Util ou Fim de Semana
	column 'Fim de Semana'
		lineageTag: 075cb532-55ba-44fb-b611-28a9ce831ad0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fim de Semana]

	/// Indica se é o último dia do mês (Sim / Nao)
	column 'Ultimo Dia Mes'
		lineageTag: 56ec4405-ec12-45a7-a04c-2577437da25b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ultimo Dia Mes]

	/// Semestre do ano (S1 ou S2)
	column Semestre
		lineageTag: aff2f699-c440-447d-8c6a-914541326502
		summarizeBy: none
		isNameInferred
		sourceColumn: [Semestre]

	/// Ano e semestre combinados (ex: 2024-S1)
	column 'Ano Semestre'
		lineageTag: abfda919-2d79-4f63-9562-8512452f7378
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano Semestre]

	partition 'dim calendário' = calculated
		mode: import
		source =
				VAR _inicio = DATE(2022, 1, 1)
				VAR _fim = DATE(2026, 12, 31)
				VAR _datas = CALENDAR(_inicio, _fim)
				RETURN
				ADDCOLUMNS(
				    _datas,
				    "Data",              [Date],
				    "Ano",              YEAR([Date]),
				    "Trimestre Num",    QUARTER([Date]),
				    "Trimestre",        "T" & QUARTER([Date]),
				    "Ano Trimestre",    YEAR([Date]) & "-T" & QUARTER([Date]),
				    "Mes Num",          MONTH([Date]),
				    "Mes Nome",         FORMAT([Date], "MMMM"),
				    "Mes Abrev",        FORMAT([Date], "MMM"),
				    "Ano Mes",          YEAR([Date]) * 100 + MONTH([Date]),
				    "Ano Mes Label",    FORMAT([Date], "MMM/YYYY"),
				    "Semana Ano",       WEEKNUM([Date], 2),
				    "Dia Semana Num",   WEEKDAY([Date], 2),
				    "Dia Semana",       FORMAT([Date], "DDDD"),
				    "Dia Semana Abrev", FORMAT([Date], "DDD"),
				    "Dia Mes",          DAY([Date]),
				    "Dia Ano",          DATEDIFF(DATE(YEAR([Date]),1,1), [Date], DAY) + 1,
				    "Fim de Semana",    IF(WEEKDAY([Date], 2) >= 6, "Fim de Semana", "Dia Util"),
				    "Ultimo Dia Mes",   IF([Date] = EOMONTH([Date], 0), "Sim", "Nao"),
				    "Semestre",         IF(MONTH([Date]) <= 6, "S1", "S2"),
				    "Ano Semestre",     YEAR([Date]) & "-" & IF(MONTH([Date]) <= 6, "S1", "S2")
				)

