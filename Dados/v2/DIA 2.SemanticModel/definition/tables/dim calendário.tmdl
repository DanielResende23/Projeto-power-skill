		sortByColumn: 'Mes Num'

	/// Abreviação do mês (jan, fev, ...)
	column 'Mes Abrev'
		lineageTag: 7d47623d-cada-4768-8537-a71d84c564fd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes Abrev]
		sortByColumn: 'Mes Num'

	/// Chave numérica ano-mês (ex: 202401) — auxiliar de ordenação
	column 'Ano Mes'
		isHidden
		formatString: 0
